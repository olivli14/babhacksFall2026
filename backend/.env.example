# Copy to backend/.env and fill in. Never commit .env.
GEMINI_MM_API_KEY=
GEMINI_MM_API_SECRET=
GEMINI_MM_ACCOUNT=primary
GEMINI_SHOP_API_KEY=
GEMINI_SHOP_API_SECRET=
GEMINI_SHOP_ACCOUNT=primary
MODE=mock

# Header X-Demo-Admin-Token must match this to start live sandbox runs
DEMO_ADMIN_TOKEN=
# Comma-separated extra CORS origins, e.g. https://your-app.vercel.app
FRONTEND_ORIGINS=
